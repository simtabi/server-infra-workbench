# RustFS add-on: EXPERIMENTAL, dev/test only. Refused on protected envs and with default credentials.
# Verified 2026-10: https://hub.docker.com/r/rustfs/rustfs/tags (1.0.4). Runs as uid 10001.
ADDON_KIND=storage
ADDON_DEFAULT_ROLE=dedicated
ADDON_RAM_MB=512
ADDON_EXPERIMENTAL=1
RUSTFS_IMAGE=rustfs/rustfs:1.0.4
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001        # console, 127.0.0.1 only: ssh -L 9001:127.0.0.1:9001 <host>
RUSTFS_MEM=768m
STORAGE_REGION=us-east-1
