# Garage add-on (S3-compatible object storage, single node; grow to 3 nodes for redundancy).
# Verified 2026-10: https://garagehq.deuxfleurs.fr/download/ (v2.5.0 is the newest stable).
ADDON_KIND=storage
ADDON_DEFAULT_ROLE=db           # db (after MySQL/MariaDB are off) | dedicated | web (warns on 2 GB nodes)
ADDON_RAM_MB=256
GARAGE_IMAGE=dxflrs/garage:v2.5.0
ADDON_NETWORK=host              # host (Garage's recommended mode; binds ADDON_BIND only) | bridge (Docker Desktop / tests)
GARAGE_S3_PORT=3900
GARAGE_RPC_PORT=3901
GARAGE_ADMIN_PORT=3903          # always 127.0.0.1
GARAGE_MEM=512m
GARAGE_ZONE=dc1
GARAGE_CAPACITY=20GB            # what this node offers to the layout; keep below the disk's free space
GARAGE_DB_ENGINE=lmdb           # lmdb (recommended) | sqlite
STORAGE_REGION=garage
