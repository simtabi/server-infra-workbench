# Gotenberg add-on: pinned defaults. addon.sh reads this file, then /etc/vsw-addons.conf overrides it.
# Verified 2026-10: https://hub.docker.com/r/gotenberg/gotenberg/tags (8.39.0 is the newest stable).
ADDON_KIND=pdf
ADDON_DEFAULT_ROLE=web          # web (next to PHP, on 127.0.0.1) | db | dedicated (private IP + basic auth)
ADDON_RAM_MB=1024               # planning estimate; also the container memory limit below
GOTENBERG_IMAGE=gotenberg/gotenberg:8.39.0   # -chromium / -libreoffice variants are smaller if you need only one engine
GOTENBERG_PORT=3000
GOTENBERG_MEM=1g
GOTENBERG_CPUS=1.0
GOTENBERG_TIMEOUT=60s
GOTENBERG_LOG_LEVEL=warn
GOTENBERG_DENY_PRIVATE_IPS=true # SSRF guard: Chromium/LibreOffice/downloadFrom may not fetch 10.x, 127.x, 169.254.x (metadata)
GOTENBERG_BASIC_AUTH=auto       # auto = on when bound to a non-loopback address
