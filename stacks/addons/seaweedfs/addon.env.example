# SeaweedFS add-on (master + volume + filer + S3 gateway in one container; optional admin UI).
# Verified 2026-10: https://github.com/seaweedfs/seaweedfs/releases (4.51 is the newest stable).
ADDON_KIND=storage
ADDON_DEFAULT_ROLE=dedicated    # heavier than Garage; dedicated or db node
ADDON_RAM_MB=512
SEAWEED_IMAGE=chrislusf/seaweedfs:4.51
SEAWEED_S3_PORT=8333
SEAWEED_ADMIN_PORT=12535        # admin UI, 127.0.0.1 only: ssh -L 12535:127.0.0.1:12535 <host>
SEAWEED_ADMIN_UI=1              # 1 = start the admin UI (password generated)
SEAWEED_VOLUME_MB=1024          # volume file size limit
SEAWEED_MEM=768m
STORAGE_REGION=us-east-1
