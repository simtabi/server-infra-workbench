# Beszel agent: pinned defaults (same release as the hub). Runs on every monitored node.
# Verified 2026-10: https://hub.docker.com/r/henrygd/beszel-agent/tags
MON_STACK=beszel
MON_SIDE=agent
MON_RAM_MB=32
MON_HEAVY=0
MON_UI_PORT_KEYS=
BESZEL_AGENT_IMAGE=henrygd/beszel-agent:0.21.1
BESZEL_AGENT_PORT=45876
