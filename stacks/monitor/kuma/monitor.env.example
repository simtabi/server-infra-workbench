# Uptime Kuma: pinned defaults. HTTP/TCP/keyword/certificate/push monitors, status pages, notifications.
# Verified 2026-10: https://hub.docker.com/r/louislam/uptime-kuma/tags (2.5.9 is the newest stable).
MON_STACK=kuma
MON_SIDE=hub
MON_RAM_MB=192
MON_HEAVY=0
MON_UI_PORT_KEYS=KUMA_PORT
KUMA_IMAGE=louislam/uptime-kuma:2.5.9
KUMA_PORT=3001
