# Prometheus hub: Prometheus + Alertmanager + Grafana + blackbox (HTTP/TLS probes). Pinned defaults.
# Verified 2026-10 (Docker Hub): prometheus v3.15.1, alertmanager v0.34.2, grafana 13.3.0, blackbox v0.29.1.
MON_STACK=prometheus
MON_SIDE=hub
MON_RAM_MB=600
MON_HEAVY=1
MON_UI_PORT_KEYS="GRAFANA_PORT PROMETHEUS_PORT ALERTMANAGER_PORT"
PROMETHEUS_IMAGE=prom/prometheus:v3.15.1
ALERTMANAGER_IMAGE=prom/alertmanager:v0.34.2
GRAFANA_IMAGE=grafana/grafana:13.3.0
BLACKBOX_IMAGE=prom/blackbox-exporter:v0.29.1
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3300               # 3000 is often taken by Gotenberg or a Node app
PROMETHEUS_RETENTION=15d
PROMETHEUS_RETENTION_SIZE=2GB
