# Netdata: pinned defaults. Per-node real-time metrics, zero config; not claimed to Netdata Cloud.
# Verified 2026-10: https://hub.docker.com/r/netdata/netdata/tags (v2.12.2 is the newest stable).
MON_STACK=netdata
MON_SIDE=node                   # node = installed on every role (hub, agent, both)
MON_RAM_MB=256
MON_HEAVY=1
MON_UI_PORT_KEYS=NETDATA_PORT
NETDATA_IMAGE=netdata/netdata:v2.12.2
NETDATA_PORT=19999
