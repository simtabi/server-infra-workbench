# Beszel hub: pinned defaults. monitor.sh reads this file, then /etc/vsw-monitor.conf overrides it.
# Verified 2026-10: https://hub.docker.com/r/henrygd/beszel/tags (0.21.1 is the newest stable).
MON_STACK=beszel
MON_SIDE=hub                    # hub = UIs and collectors (one node) | agent = every monitored node
MON_RAM_MB=64                   # planning estimate (the RAM gate adds these up)
MON_HEAVY=0                     # 1 = blocked next to a database on a <=2 GB node unless MONITOR_ALLOW_TIGHT=1
MON_UI_PORT_KEYS=BESZEL_PORT    # loopback ports `monitor tunnel` forwards
BESZEL_IMAGE=henrygd/beszel:0.21.1
BESZEL_PORT=8090
BESZEL_ADMIN_EMAIL=admin@example.com   # first admin (new installs only); the password is generated into secrets.env
