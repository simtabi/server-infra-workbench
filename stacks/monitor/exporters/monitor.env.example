# Prometheus exporters (agent side of the prometheus stack): node-exporter + cAdvisor on every node,
# postgres-exporter + pgbouncer-exporter where the DB manager runs (MONITOR_PG=auto|1|0).
# Verified 2026-10 (Docker Hub / GitHub releases): node-exporter v1.12.1, cAdvisor v0.60.6 (ghcr.io),
# postgres-exporter v0.20.1, pgbouncer-exporter v0.12.1.
MON_STACK=prometheus
MON_SIDE=agent
MON_RAM_MB=120
MON_HEAVY=0
MON_UI_PORT_KEYS=
NODE_EXPORTER_IMAGE=prom/node-exporter:v1.12.1
CADVISOR_IMAGE=ghcr.io/google/cadvisor:v0.60.6
POSTGRES_EXPORTER_IMAGE=prometheuscommunity/postgres-exporter:v0.20.1
PGBOUNCER_EXPORTER_IMAGE=prometheuscommunity/pgbouncer-exporter:v0.12.1
NODE_EXPORTER_PORT=9100
CADVISOR_PORT=9338
POSTGRES_EXPORTER_PORT=9187
PGBOUNCER_EXPORTER_PORT=9127
