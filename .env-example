# server-infra-workbench: workstation settings. Copy to .env (git-ignored, never commit it) and chmod 600 .env.
#   cp .env-example .env && chmod 600 .env
# Every SIWO_DB_<KEY> is the DB manager's <KEY> (config/db-server.env.example, docs/reference/configuration-keys.md).
# The tools read this file line by line (KEY=VALUE); it is never sourced. Docs: docs/databases/users-and-privileges.md
# Env files live in the repo root only: .env is the single source of local settings (one client per file; for
# more, .env.<client> next to it and --env-file .env.<client>). The SIWO_DB_* server keys below become the DB
# server's /etc/docker-db-server-manager.conf on every remote-run.sh / bin/siwo db engines run (passwords,
# SIWO_DB_SSH_* and SIWO_DB_LOCAL_* are never sent); --config FILE overrides, --no-config skips.

# ---- engines on the DB server (1 = on, 0 = off) ---------------------------------------------
# Apply: bin/siwo db engines plan   then   bin/siwo db engines apply
# Turning an engine off stops and removes only its container; the other engines keep running (no restart)
# and its data volume is kept (apply --purge deletes it after a backup and a typed confirmation).
# PgBouncer needs Postgres. A Postgres-only app (e.g. Laravel on pgsql) can set MYSQL and MARIADB to 0 to free RAM.
SIWO_DB_ENABLE_POSTGRES=1
SIWO_DB_ENABLE_PGBOUNCER=1
SIWO_DB_ENABLE_MYSQL=1
SIWO_DB_ENABLE_MARIADB=1
SIWO_DB_ENABLE_ADMINER=0

# ---- master (admin) users: one per engine, for you and your DB client, never for apps ------
# Postgres master = the bootstrap superuser. Keep vsw_admin on servers installed before 1.6.0 (renaming it
# later is not supported). MySQL/MariaDB master = a named admin next to root (root stays server-local).
SIWO_DB_PG_ADMIN_USER=vsw_admin
SIWO_DB_MYSQL_ADMIN_USER=siwo_admin
SIWO_DB_MARIADB_ADMIN_USER=siwo_admin
# Passwords: leave empty here. In your .env, generate them (never type or reuse one):
#   for k in PG MYSQL MARIADB; do sed -i.bak "s|^SIWO_DB_${k}_ADMIN_PASSWORD=.*|SIWO_DB_${k}_ADMIN_PASSWORD=$(openssl rand -hex 24)|" .env; done; rm -f .env.bak
# The live passwords are generated on the server and kept in its /opt/db/.env (600); no tool sends this file's
# passwords anywhere. Sync your copy from the server: admin-creds <engine> --out FILE (then shred -u FILE).
# A value here seeds a NEW key only when you hand it to the manager yourself (SIWO_DB_<KEY> in its env or config).
SIWO_DB_PG_ADMIN_PASSWORD=
SIWO_DB_MYSQL_ADMIN_PASSWORD=
SIWO_DB_MARIADB_ADMIN_PASSWORD=
# CIDRs the MySQL/MariaDB master may log in from (empty = the Docker network + VPC_CIDR; never 0.0.0.0/0)
SIWO_DB_MY_ADMIN_HOSTS=
SIWO_DB_MY_ADMIN_PRIVS=ALL PRIVILEGES
SIWO_DB_MY_ADMIN_GRANT_OPTION=1

# ---- app databases and their users (create-db <name>: owner login <name>, never a superuser) ----
# Postgres app login may create tenant databases (CREATEDB)
SIWO_DB_PG_APP_CREATEDB=1
# 1 = create-db also creates <name>_ro (read-only); same as create-db --readonly-user
SIWO_DB_DB_READONLY_USER=0
# Host part of MySQL/MariaDB app users (the ports listen on the private IP only)
SIWO_DB_MY_APP_HOST=%
# MySQL/MariaDB privilege sets (database-level only; ALL, GRANT OPTION, FILE, SUPER, PROCESS are refused).
# Empty = the defaults in config/db-server.env.example.
SIWO_DB_MY_OWNER_PRIVS=
SIWO_DB_MY_RW_PRIVS=
SIWO_DB_MY_RO_PRIVS=

# ---- connecting from this machine (SSH tunnel; docs/databases/connecting-local-clients.md) ----
# the DB server's ssh login: user@public-ip (e.g. ploi@203.0.113.10) or an alias from ~/.ssh/config
SIWO_DB_SSH_HOST=<db-ssh-alias>
# private key for that login, used alone (ssh -i KEY -o IdentitiesOnly=yes); empty = ssh's own choice
SIWO_DB_SSH_IDENTITY=
# its private VPC IP: the wrong-server guard (--expect-ip) and the address the ports bind to
SIWO_DB_PRIVATE_IP=<db-private-ip>
# local ends of the tunnel: point TablePlus / DBeaver / DataGrip / psql / mysql at 127.0.0.1:<port>
SIWO_DB_LOCAL_PG=15432
SIWO_DB_LOCAL_PGBOUNCER=16432
SIWO_DB_LOCAL_MYSQL=13306
SIWO_DB_LOCAL_MARIADB=13307
SIWO_DB_LOCAL_ADMINER=8081

# ---- DB server settings (sent as /etc/docker-db-server-manager.conf; no secrets) ---------------
# Any manager key works as SIWO_DB_<KEY> (config/db-server.env.example). Empty or commented = server default.
# This replaces the old local/<client>/db-server.conf: copy its KEY=VALUE lines here as SIWO_DB_KEY=VALUE.
# SIWO_DB_EXPECTED_PRIVATE_IP=10.0.0.5
# SIWO_DB_VPC_CIDR=10.0.0.0/20
# SIWO_DB_PG_USER=app
# SIWO_DB_PG_DB=app
# SIWO_DB_WEB_ENV=production
