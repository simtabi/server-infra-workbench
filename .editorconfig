root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.sh]
indent_size = 2

[*.{js,ts,json,yml,yaml}]
indent_size = 2

[*.py]
indent_size = 4

[{Makefile,Caddyfile}]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

# shfmt reads these (make fmt-check): 2-space indent, binary ops may start a line, indent case bodies.
[{*.sh,bin/siwo}]
indent_size = 2
shell_variant = bash
binary_next_line = true
switch_case_indent = true
space_redirects = false

[src/php/**.php]
indent_size = 4
