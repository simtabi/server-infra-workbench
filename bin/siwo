#!/usr/bin/env bash
# siwo - server-infra-workbench front door (Server + Infrastructure + WOrkbench): one entry point for every tool in the repo.
#
#   bin/siwo list                       every tool and where it lives
#   bin/siwo <area> <tool> [args...]    run src/shell/<area>/<tool>.sh    e.g. bin/siwo db remote-run --help
#                                            server init|harden|update|inventory, web diagnose: plan first, --yes to apply
#   bin/siwo do|cf|gcp|github|ploi ...  platform APIs (PHP core)      e.g. bin/siwo do snapshot 123 --dry-run
#   bin/siwo keys [...]                 SSH keys: provider accounts + servers (menu without args)
#   bin/siwo health <url>...            check health endpoints (status, body, latency)
#   bin/siwo credentials                which API credentials are set (never prints values)
#   bin/siwo py <command> [args...]     the Python package CLI        e.g. bin/siwo py ping 10.0.0.5 6432
#   bin/siwo plans [flags]              DO plans per region via Ploi  e.g. bin/siwo plans --regions nyc3
#   bin/siwo addon <cmd> [name]         add-ons on this node (run on the server) e.g. bin/siwo addon plan garage
#   bin/siwo monitor <cmd>              monitoring stacks (Beszel, Uptime Kuma, Netdata, Prometheus+Grafana) e.g. monitor plan
#   bin/siwo status [--host H] [--json] one-screen node health (load, RAM, disk, containers, backups); read-only
#   bin/siwo env init|check --env E     Laravel .env per environment (APP_KEY generated, values never shown)
#   bin/siwo configure [--profile P]    wizard: profile + overrides -> local/<client>/ (no secrets)
#   bin/siwo profile list|show|diff     the setup profiles in config/profiles
#
#   bin/siwo db engines plan|apply      DB engines on/off             e.g. bin/siwo db engines apply --host user@203.0.113.10 -i ~/.ssh/db-key
#
# Local settings: the repo-root .env (git-ignored; template .env-example) is the single source. db remote-run and
# db engines read SIWO_DB_SSH_HOST / _SSH_IDENTITY / _PRIVATE_IP and the SIWO_DB_* server keys from it; flags
# override, SIWO_ENV_FILE=path (or --env-file) points at another root env file such as .env.<client>.
# Writes need --yes (or typing yes), destructive ones also --force; --dry-run sends nothing.
# Shell tools keep their own flags; this script only resolves paths and execs.
set -euo pipefail
ROOT="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")/.." && pwd)"

# usage: the header comment block (up to the first code line), minus shellcheck directives
usage() { awk 'NR==1{next} !/^#/{exit} /^# shellcheck /{next} {sub(/^# ?/,""); print}' "$0"; }
die() { echo "siwo: $*" >&2; exit "${CODE:-2}"; }

list() {
  echo "shell tools (bin/siwo <area> <tool>):"
  find "$ROOT/src/shell" -mindepth 2 -maxdepth 2 -name '*.sh' -not -path '*/lib/*' | sort | while read -r f; do
    a="$(basename "$(dirname "$f")")"; t="$(basename "$f" .sh)"; printf '  %-8s %-28s src/shell/%s/%s.sh\n' "$a" "$t" "$a" "$t"
  done
  echo "platform APIs (PHP core, src/php):"
  printf '  %-45s %s\n' "do droplets|snapshot|snapshots" "DigitalOcean" "cf zones|dns list|upsert|delete" "Cloudflare" \
    "do firewalls|firewall-apply|uptime|droplet-create" "DigitalOcean (writes are plan-then-confirm)" \
    "do resize|alerts" "DigitalOcean resize, monitoring alert policies" \
    "ploi servers|sites|deploy" "Ploi" "ploi site-create|deploy-script|daemons" "Ploi" \
    "do volumes|vpcs|domains|dns|reserved-ips" "DigitalOcean storage, networking, DNS" \
    "do spaces-keys|projects|tags|power" "DigitalOcean keys, projects, tags, power" \
    "cf settings|ssl|origin-certs|purge|firewall" "Cloudflare SSL, certificates, cache, firewall" \
    "gcp instances|snapshots|firewalls" "Google Compute Engine" \
    "gcp instance|firewall-create|dns|buckets" "GCE writes, Cloud DNS, Cloud Storage" \
    "github repos|runs|dispatch|secrets|releases" "GitHub (alias gh)" \
    "ploi crons|databases|certs|server-restart" "Ploi cron, databases, SSL" \
    "keys [providers|account|server|fingerprint]" "SSH keys (DO, Vultr, Hetzner, Linode, Scaleway; servers)" \
    "health <url>..." "health endpoint check" "credentials" "credential check"
  echo "shortcuts (shell, src/shell):"
  printf '  %-37s %s\n' "env init|check --env E --site S" "Laravel .env: create/check per env (src/shell/env)" \
    "addon list|plan|install|doctor <name>" "add-ons on this node (src/shell/addons)" \
    "monitor list|plan|install|doctor" "monitoring stacks on this node (src/shell/monitor)" \
    "status [--host H] [--json]" "one-screen node health (src/shell/server/status.sh)"
  echo "python (src/python):"
  printf '  %-37s %s\n' "py ping [host port] [--env FILE]" "TCP reachability probe" \
    "plans [--regions ..] [--env-file F]" "droplet plans per region available through Ploi" \
    "configure [--profile P --client C]" "setup wizard -> local/<client>/" \
    "profile list|show|diff" "setup profiles (config/profiles)"
}

php_core() {
  command -v php >/dev/null 2>&1 || CODE=127 die "php is not installed (PHP 8.4+ needed for '$1')"
  php -r 'exit(PHP_VERSION_ID >= 80400 ? 0 : 1);' || CODE=1 die "PHP 8.4+ is required, found $(php -r 'echo PHP_VERSION;')"
  [ -f "$ROOT/src/php/vendor/autoload.php" ] || CODE=1 die "PHP dependencies missing; run: composer install --working-dir=\"$ROOT/src/php\""
  exec php "$ROOT/src/php/bin/siwo-php" "$@"
}

case "${1:-}" in
  ""|-h|--help|help) if [ -n "${2:-}" ]; then php_core help "$2"; else usage; fi ;;
  list) list ;;
  --version|version) php_core version ;;
  do|digitalocean|cf|cloudflare|ploi|gcp|gcloud|github|gh|keys|health|credentials|creds) php_core "$@" ;;
  php) shift; php_core "$@" ;;
  env) shift; exec "$ROOT/src/shell/env/env.sh" "$@" ;;
  addon|addons) shift; [ "${1:-}" = addon ] && shift; exec "$ROOT/src/shell/addons/addon.sh" "$@" ;;
  monitor) shift; exec "$ROOT/src/shell/monitor/monitor.sh" "$@" ;;
  status) shift; exec "$ROOT/src/shell/server/status.sh" "$@" ;;
  configure|profile) command -v python3 >/dev/null 2>&1 || CODE=127 die "python3 is not installed"
       SIWO_ROOT="$ROOT" PYTHONPATH="$ROOT/src/python/src${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m server_infra_workbench "$@" ;;
  plans) shift; command -v python3 >/dev/null 2>&1 || CODE=127 die "python3 is not installed"
       PYTHONPATH="$ROOT/src/python/src${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m server_infra_workbench plans "$@" ;;
  py|python) shift; command -v python3 >/dev/null 2>&1 || CODE=127 die "python3 is not installed"
       PYTHONPATH="$ROOT/src/python/src${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m server_infra_workbench "$@" ;;
  *) area="$1"; tool="${2:-}"
     [[ "$area" =~ ^[a-z0-9-]+$ && "$tool" =~ ^[a-z0-9-]+$ && "$area" != lib ]] || die "usage: bin/siwo <area> <tool> [args] (see: bin/siwo list)"
     f="$ROOT/src/shell/$area/$tool.sh"
     [ -f "$f" ] || f="$ROOT/src/shell/$area/$area-$tool.sh"   # e.g. server init -> server/server-init.sh
     [ -f "$f" ] || die "no tool src/shell/$area/$tool.sh (see: bin/siwo list)"
     shift 2; exec "$f" "$@" ;;
esac
