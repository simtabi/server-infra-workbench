#!/usr/bin/env bash
# workbench - the old name of bin/siwo (ADR 0014). Deprecated: forwards every argument to bin/siwo after a
# one-line notice on stderr (once per process tree; SIWO_QUIET=1 hides it). Will be removed after 1.0.
set -euo pipefail
if [ -z "${SIWO_SHIM_NOTED:-}" ] && [ "${SIWO_QUIET:-${VSW_QUIET:-0}}" != 1 ]; then
  echo "note: bin/workbench is deprecated, use bin/siwo (the old name still works for now)" >&2
fi
export SIWO_SHIM_NOTED=1
exec "$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")" && pwd)/siwo" "$@"
