#!/usr/bin/env bash
# vsw - vps-server-workbench dispatcher: one entry point for every tool in the repo.
#
#   bin/vsw list                         every tool and where it lives
#   bin/vsw <area> <tool> [args...]      run shell/<area>/<tool>.sh   e.g. bin/vsw db remote-run --help
#   bin/vsw php <command> [args...]      run the PHP package CLI      e.g. bin/vsw php ping --env web-db.env
#   bin/vsw py <command> [args...]       run the Python package CLI   e.g. bin/vsw py ping 10.0.0.5 6432
#
# It only resolves paths and execs; every tool keeps its own flags and behaviour.
set -euo pipefail
ROOT="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")/.." && pwd)"

usage() { sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; }
list() {
  echo "shell tools (bin/vsw <area> <tool>):"
  find "$ROOT/shell" -mindepth 2 -maxdepth 2 -name '*.sh' | sort | while read -r f; do
    a="$(basename "$(dirname "$f")")"; t="$(basename "$f" .sh)"; printf '  %-8s %-28s shell/%s/%s.sh\n' "$a" "$t" "$a" "$t"
  done
  echo "php:    bin/vsw php ping ...     (php/bin/vsw-php)"
  echo "python: bin/vsw py ping ...      (python -m vps_server_workbench)"
}

case "${1:-}" in
  ""|-h|--help|help) usage ;;
  list) list ;;
  php) shift; command -v php >/dev/null 2>&1 || { echo "vsw: php is not installed" >&2; exit 127; }
       exec php "$ROOT/php/bin/vsw-php" "$@" ;;
  py|python) shift; command -v python3 >/dev/null 2>&1 || { echo "vsw: python3 is not installed" >&2; exit 127; }
       PYTHONPATH="$ROOT/python/src${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m vps_server_workbench "$@" ;;
  *) area="$1"; tool="${2:-}"
     [[ "$area" =~ ^[a-z0-9-]+$ && "$tool" =~ ^[a-z0-9-]+$ ]] || { echo "vsw: usage: bin/vsw <area> <tool> [args] (see bin/vsw list)" >&2; exit 2; }
     f="$ROOT/shell/$area/$tool.sh"
     [ -f "$f" ] || { echo "vsw: no tool shell/$area/$tool.sh (see bin/vsw list)" >&2; exit 2; }
     shift 2; exec "$f" "$@" ;;
esac
