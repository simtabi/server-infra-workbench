# Copy to .env next to docker-compose.yml (never commit .env).
COMPOSE_PROJECT_NAME=web
# One domain, or a comma-separated list: staging.example.com, www.staging.example.com
SITE_DOMAIN=example.com
# Laravel checkout on the server (must contain public/ and .env)
APP_PATH=./app
APP_IMAGE=local/laravel-fpm:8.5
CADDY_IMAGE=caddy:2.11
PROXY_NETWORK=web
# Let's Encrypt staging while testing (untrusted certs, high rate limits):
# ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
ACME_CA=https://acme-v02.api.letsencrypt.org/directory
# Only for variants/reverse-proxy.Caddyfile
UPSTREAM=app:8000
