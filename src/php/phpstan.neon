includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon

parameters:
    level: max
    paths:
        - src
        - tests
    excludePaths:
        # a standalone php -S router script (globals, superglobals), not library or test code
        - tests/Fixtures/MockApi/router.php
    tmpDir: .phpstan.cache
    treatPhpDocTypesAsCertain: false
