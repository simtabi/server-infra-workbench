{
    "preset": "laravel",
    "rules": {
        "declare_strict_types": true,
        "final_class": false,
        "fully_qualified_strict_types": true,
        "global_namespace_import": {"import_classes": false, "import_constants": false, "import_functions": false},
        "strict_comparison": true,
        "void_return": true,
        "phpdoc_align": false
    },
    "exclude": ["vendor"]
}
