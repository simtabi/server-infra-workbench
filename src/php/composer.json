{
    "name": "simtabi/server-infra-workbench",
    "description": "PHP core of server-infra-workbench: safe, fluent clients for DigitalOcean, Ploi, Cloudflare, Google Cloud and GitHub, plus the siwo CLI.",
    "type": "library",
    "license": "MIT",
    "keywords": ["digitalocean", "ploi", "cloudflare", "gcp", "github", "vps", "devops", "psr-18"],
    "authors": [
        {"name": "Simtabi LLC", "email": "opensource@simtabi.com", "homepage": "https://opensource.simtabi.com", "role": "Organization"},
        {"name": "Imani Manyara", "email": "imani@simtabi.com", "role": "Maintainer"}
    ],
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "ext-openssl": "*",
        "guzzlehttp/guzzle": "^7.10 || ^8.3",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "psr/log": "^3.0"
    },
    "suggest": {
        "ext-sodium": "Required for `siwo github secrets set` (GitHub secrets are sealed with libsodium)"
    },
    "require-dev": {
        "laravel/pint": "^1.32",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {"Simtabi\\ServerInfraWorkbench\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"Simtabi\\ServerInfraWorkbench\\Tests\\": "tests/"}
    },
    "bin": ["bin/siwo-php"],
    "scripts": {
        "test": "phpunit --no-coverage",
        "lint": ["@pint", "@phpstan"],
        "pint": "pint --test",
        "pint-fix": "pint",
        "phpstan": "phpstan analyse --no-progress --memory-limit=512M",
        "format": "@pint-fix"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform-check": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
