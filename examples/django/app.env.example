PGPORT=5432
PGDATABASE=api_stg
PGUSER=api_stg_app
PGSSLMODE=prefer
PGPASSFILE=/home/ploi/api.example.com-shared/.pgpass
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=api.example.com
