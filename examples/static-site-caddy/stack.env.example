# stacks/caddy/.env for a static site (copy it there; never commit .env). Only caddy runs (`up --no-deps caddy`),
# so APP_PATH/APP_IMAGE are unused.
COMPOSE_PROJECT_NAME=site
SITE_DOMAIN=www.example.com, example.com
# the built site (index.html at the top), uploaded by your CI or `rsync -a --delete dist/ web-01:/srv/www/site/`
SITE_PATH=/srv/www/site
CADDY_IMAGE=caddy:2.11
PROXY_NETWORK=web
# Let's Encrypt staging while testing (untrusted certs, high rate limits):
# ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
ACME_CA=https://acme-v02.api.letsencrypt.org/directory
