# A static site: Caddy serves files from /srv/site, gets and renews the certificate itself.
# Mounted by compose.static.yml over stacks/caddy's conf/ (the stack's own Caddyfile stays untouched).
{
	acme_ca {$ACME_CA:https://acme-v02.api.letsencrypt.org/directory}
}

{$SITE_DOMAIN} {
	root * /srv/site
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	# fingerprinted build output (app.3f9c1e.js): cache for a year; everything else revalidates
	@hashed path_regexp hashed \.[0-9a-f]{6,}\.(css|js|woff2|png|jpg|svg|webp)$
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	header ?Cache-Control "public, max-age=0, must-revalidate"

	# /about -> /about.html or /about/index.html; a single-page app would end with /index.html instead
	try_files {path} {path}.html {path}/index.html
	file_server

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
	log
}
