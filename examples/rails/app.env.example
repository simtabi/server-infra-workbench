# /home/ploi/shop.example.com-shared/.env as examples/_shared/app-env.sh --stack rails writes it.
# Placeholders only: the password is in .pgpass (600), SECRET_KEY_BASE is generated on the server.
PGHOST=10.0.0.5
PGPORT=5432
PGDATABASE=shop_stg
PGUSER=shop_stg_app
PGSSLMODE=prefer
PGPASSFILE=/home/ploi/shop.example.com-shared/.pgpass
SECRET_KEY_BASE=
RAILS_ENV=production
RAILS_LOG_LEVEL=info
RAILS_MAX_THREADS=3
WEB_CONCURRENCY=2
SOLID_QUEUE_IN_PUMA=1
