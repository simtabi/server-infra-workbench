# The two-node part of the shared .env, the same on web-01 and web-02 (DB_*: `bin/workbench env init`, one per node).
# Nothing a request needs may live on one node's disk: sessions, cache, locks and queues in Managed Valkey
# (TLS, VPC), uploads in Spaces. A user whose next request lands on the other node must not notice.
SESSION_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=private-valkey-shop-do-user-0000000-0.db.ondigitalocean.com
REDIS_PORT=25061
REDIS_SCHEME=tls
REDIS_USERNAME=default
REDIS_PASSWORD=
FILESYSTEM_DISK=s3
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=shop-uploads
AWS_ENDPOINT=https://nyc3.digitaloceanspaces.com
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# the load balancer reaches the nodes over the VPC; Laravel trusts it there (bootstrap/app.php, README)
APP_URL=https://app.example.com
