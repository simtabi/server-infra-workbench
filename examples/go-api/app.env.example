PGPORT=5432
PGDATABASE=api_stg
PGUSER=api_stg_app
PGSSLMODE=prefer
PGPASSFILE=/home/ploi/api.example.com-shared/.pgpass
LISTEN_ADDR=127.0.0.1:8080
