# The Horizon + Reverb part of /home/ploi/app.example.com-shared/.env (DB_* comes from `bin/siwo env init`).
# Placeholders only: the REVERB_APP_* values are generated on the server (README), never typed or committed.
QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# where browsers (and the app's own broadcasts) reach Reverb: through Nginx, TLS on 443
REVERB_HOST=app.example.com
REVERB_PORT=443
REVERB_SCHEME=https
# where the Reverb daemon listens: loopback only
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
# Vite inlines these at build time (the deploy links the .env before `npm run build`)
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
