# /home/ploi/shop.example.com-shared/.env as examples/_shared/app-env.sh --stack symfony writes it.
# Placeholders only. DATABASE_URL carries the user and no password: pdo_pgsql (libpq) reads that from
# ~/.pgpass of the PHP-FPM user (ploi), mode 600. APP_SECRET is generated on the server.
PGHOST=10.0.0.5
PGPORT=5432
PGDATABASE=shop_stg
PGUSER=shop_stg_app
PGSSLMODE=prefer
DATABASE_URL='postgresql://shop_stg_app@10.0.0.5:5432/shop_stg?serverVersion=18&charset=utf8&sslmode=prefer'
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
