# The Octane part of /home/ploi/app.example.com-shared/.env (DB_*, APP_KEY: `bin/workbench env init`).
OCTANE_SERVER=frankenphp
OCTANE_HTTPS=false            # TLS ends at Nginx; Octane serves plain HTTP on loopback
# Octane keeps the app in memory: one process serves many requests, so the DB connection is reused, not
# reopened per request. Use the direct port (5432): a long-lived connection gains nothing from PgBouncer's
# session pool. Workers x 1 connection must fit the role's connection limit.
DB_PORT=5432
SESSION_DRIVER=database
CACHE_STORE=database
