# Copy to .env and fill in. Any value here can be overridden by an
# environment variable or a --flag of the same name.

# Required
PLOI_API_TOKEN=
DO_API_TOKEN=

# API endpoints
PLOI_API_URL=https://ploi.io/api
DO_API_URL=https://api.digitalocean.com/v2

# Which Ploi credentials to use
PLOI_PROVIDER=digitalocean
PLOI_CREDENTIAL_ID=

# Filters (blank or 0 = no filter)
REGIONS=                # e.g. nyc3,atl1
EXCLUDE_REGIONS=
PLAN_FILTER=            # e.g. s- (Basic) or -intel (Premium Intel)
MIN_VCPUS=0
MAX_VCPUS=0
MIN_MEMORY_MB=0
MAX_MEMORY_MB=0
MAX_PRICE=0

# Output
SORT_BY=price           # price, memory, vcpus, plan
OUTPUT_FORMAT=table     # table, markdown, csv, json
OUTPUT_FILE=
TIMEOUT=30
