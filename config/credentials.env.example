# Workbench credentials (workstation side) - template for
#   ~/.config/server-infra-workbench/credentials   (chmod 600, outside any git repo)
# or export the same names as environment variables (env wins over the file).
# Fill only the providers you use. Check with: bin/workbench credentials (never prints values).
#   install -m 600 /dev/null ~/.config/server-infra-workbench/credentials && $EDITOR ~/.config/server-infra-workbench/credentials

# Scopes per command: docs/providers/<provider>.md. A read-only token is enough for listings and --dry-run.
# DigitalOcean: custom-scoped personal access token (api:read for reads; add droplet, block_storage, vpc, firewall,
#   monitoring, uptime, ssh_key, spaces_key, domain, reserved_ip, project, tag create/update/delete as used)
DIGITALOCEAN_TOKEN=
# Cloudflare: API token on specific zones (not the Global API Key): Zone:Read + DNS:Edit; Zone Settings:Edit (ssl,
#   settings), SSL and Certificates:Edit (origin-certs), Cache Purge:Purge, Firewall Services:Edit, Zone WAF:Read as used
CLOUDFLARE_API_TOKEN=
# Ploi: API key (Profile > API keys) with the Read scopes plus only the Create/Delete scopes you use
PLOI_API_TOKEN=
# Google Cloud: path to a service-account JSON key (kept outside the repo), and the default project
GOOGLE_APPLICATION_CREDENTIALS=
GCP_PROJECT=
# GitHub: fine-grained token on selected repositories, with an expiry: Metadata/Contents/Actions read; Actions,
#   Secrets, Environments, Administration (deploy keys), Contents (releases) write as used
GITHUB_TOKEN=
# SSH key providers for `workbench keys account ...`
VULTR_API_KEY=
HCLOUD_TOKEN=
LINODE_TOKEN=
SCW_SECRET_KEY=
SCW_PROJECT_ID=

# Optional settings (not secrets)
# SIW_CREDENTIALS_FILE=/path/to/another/credentials   # a different credentials file
# SIW_KEYS_CONFIG=~/.config/server-infra-workbench/keys.json
# SIW_DROPLET_IMAGE=ubuntu-24-04-x64   # droplet-create image; default ubuntu-26-04-x64 (newest LTS), "latest" asks the API
# SIW_AUDIT_LOG=~/.local/state/server-infra-workbench/audit.log   # or "off"
