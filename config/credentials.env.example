# Workbench credentials (workstation side) - template for
#   ~/.config/vps-server-workbench/credentials   (chmod 600, outside any git repo)
# or export the same names as environment variables (env wins over the file).
# Fill only the providers you use. Check with: bin/workbench credentials (never prints values).
#   install -m 600 /dev/null ~/.config/vps-server-workbench/credentials && $EDITOR ~/.config/vps-server-workbench/credentials

# DigitalOcean: personal access token (read + write; scope it to droplet, firewall, monitoring, uptime, ssh_key)
DIGITALOCEAN_TOKEN=
# Cloudflare: API token with Zone:Read + DNS:Edit on the zones you manage (not the Global API Key)
CLOUDFLARE_API_TOKEN=
# Ploi: API token (Profile > API keys)
PLOI_API_TOKEN=
# Google Cloud: path to a service-account JSON key (kept outside the repo), and the default project
GOOGLE_APPLICATION_CREDENTIALS=
GCP_PROJECT=
# SSH key providers for `workbench keys account ...`
VULTR_API_KEY=
HCLOUD_TOKEN=
LINODE_TOKEN=
SCW_SECRET_KEY=
SCW_PROJECT_ID=

# Optional settings (not secrets)
# VSW_CREDENTIALS_FILE=/path/to/another/credentials   # a different credentials file
# VSW_KEYS_CONFIG=~/.config/vps-server-workbench/keys.json
# VSW_AUDIT_LOG=~/.local/state/vps-server-workbench/audit.log   # or "off"
