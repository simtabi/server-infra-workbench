# Laravel app .env template (Laravel 12/13 skeleton keys + what this workbench's stack uses).
# `workbench env init` starts from this file, fills per-environment defaults, generates APP_KEY
# and writes the real .env on the server (mode 600). Never commit a filled copy.
# Values here are placeholders or safe defaults; empty means "set per environment".

APP_NAME="My App"
APP_ENV=local                  # local | staging | production (env init sets it from --env)
APP_KEY=                       # generated once per environment by env init; never rotate blindly
APP_DEBUG=true                 # env init forces false on stg and prd
APP_URL=http://localhost       # https:// on stg and prd

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file    # "cache" (with a shared store) when there are several web nodes
# APP_MAINTENANCE_STORE=redis

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily                # daily files instead of one ever-growing laravel.log
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug                # env init: warning on stg, error on prd

# Database: copy from `sudo /root/docker-db-server-manager.sh env --env <env>` on the DB server
# (env init --from that file). Use the PRIVATE IP; PgBouncer is 6432, Postgres 5432, MySQL 3306.
DB_CONNECTION=pgsql            # pgsql | mysql | mariadb | sqlite
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=app
DB_USERNAME=app                # the per-env app user, never root/postgres
DB_PASSWORD=
DB_SSLMODE=prefer              # require when the manager has TLS on

SESSION_DRIVER=database        # redis when Redis is available
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false    # env init: true on stg and prd (https only)

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database      # needs a worker: workbench ploi daemon-create ... queue:work
CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log                # smtp/ses/postmark on prd; log only in dev
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# S3-compatible storage: DO Spaces, or a Garage/SeaweedFS add-on on the private network
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=                  # e.g. https://nyc3.digitaloceanspaces.com or http://10.0.0.5:3900
AWS_USE_PATH_STYLE_ENDPOINT=false   # true for Garage / SeaweedFS / RustFS

# Gotenberg add-on (HTML/Office -> PDF), private network only
GOTENBERG_URL=

# Behind a load balancer or Cloudflare: trust the proxy so URLs and client IPs are right
# TRUSTED_PROXIES=10.0.0.0/8

VITE_APP_NAME="${APP_NAME}"
