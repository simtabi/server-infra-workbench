# docker-db-server-manager.sh configuration.
# Install on the DB server as /etc/docker-db-server-manager.conf (chmod 600), or
# pass --config FILE / DBM_CONFIG=FILE. Environment variables override this file.
# No secrets here: passwords are generated into $DB_DIR/.env by install/reset.

# --- network -------------------------------------------------------------------
# Private VPC IP every port binds to. Default: the IPv4 on PRIVATE_IFACE.
#   Find it with: ip -4 -o addr show eth1
PRIVATE_IP=
PRIVATE_IFACE=eth1
# Refuse to run unless this IP is on the host (wrong-server guard). Recommended.
EXPECTED_PRIVATE_IP=
# ufw source range allowed to reach the DB ports (your DO VPC range).
VPC_CIDR=10.0.0.0/8

# --- paths -----------------------------------------------------------------------
DB_DIR=/opt/db
BACKUP_DIR=/opt/db/backups
KEEP=7
CRON_TIME=15 3 * * *
CRON_FILE=/etc/cron.d/docker-db-server-backup
CRON_LOG=/var/log/docker-db-server-backup.log
# Shown in `env` output as the place to paste the DB_* lines.
WEB_ENV=/home/ploi/example.com-shared/.env

# --- PostgreSQL ------------------------------------------------------------------
PG_USER=app
PG_DB=app
PG_IMAGE=local/postgres:18-postgis-pgvector
PG_BASE_IMAGE=postgis/postgis:18-3.6
PGVECTOR_PKG=postgresql-18-pgvector
PG_MAX_CONNECTIONS=200
PG_PORT=5432

# --- PgBouncer (session mode, scram-sha-256) -------------------------------------
PGBOUNCER_IMAGE=edoburu/pgbouncer:v1.26.1-p0
PGBOUNCER_PORT=6432
PGBOUNCER_MAX_CLIENT_CONN=500
PGBOUNCER_POOL_SIZE=20

# --- MySQL / MariaDB -------------------------------------------------------------
MYSQL_IMAGE=mysql:9.7
MYSQL_PORT=3306
MARIADB_IMAGE=mariadb:13
MARIADB_PORT=3307
